# Dev/test image for shani-shell: a nested niri under headless weston, with the
# services the shell's modules talk to (PipeWire, UPower, polkit, NetworkManager,
# BlueZ, power-profiles-daemon) so each feature can be exercised, not just parsed.
#   docker build -t shani-shell-dev -f dev/Containerfile dev
#   docker run --rm -v "$PWD":/work shani-shell-dev sh /work/dev/<test>.sh
FROM archlinux:latest
RUN pacman -Syu --noconfirm --needed \
        niri weston quickshell xwayland-satellite \
        grim wtype foot swaybg imagemagick \
        python python-gobject dbus libnotify playerctl \
        pipewire wireplumber pipewire-pulse \
        upower power-profiles-daemon polkit networkmanager bluez bluez-utils \
        brightnessctl gnome-themes-extra adwaita-icon-theme \
        wf-recorder wl-clipboard cliphist wlsunset \
        nautilus gnome-text-editor gnome-calculator \
        ttf-dejavu noto-fonts mesa \
    && pacman -Scc --noconfirm
# Lens (OCR, codes, region select) and the clipboard tools the session starts
RUN pacman -Sy --noconfirm --needed tesseract tesseract-data-eng slurp zbar wl-clip-persist \
    && pacman -Scc --noconfirm
# the launcher's emoji mode and removable drives
RUN pacman -Sy --noconfirm --needed unicode-emoji udisks2 && pacman -Scc --noconfirm
# input methods: fcitx5 + m17n (Devanagari phonetic/inscript and other Indic tables)
RUN pacman -Sy --noconfirm --needed fcitx5 fcitx5-m17n fcitx5-gtk fcitx5-qt && pacman -Scc --noconfirm
# voice typing, end to end: espeak-ng speaks, whisper.cpp (tiny model) hears
RUN pacman -Sy --noconfirm --needed whisper-cpp espeak-ng poppler fd ripgrep && pacman -Scc --noconfirm \
    && mkdir -p /opt/whisper && curl -sSL -o /opt/whisper/ggml-tiny.en.bin \
       https://huggingface.co/ggerganov/whisper.cpp/resolve/main/ggml-tiny.en.bin
# the shell's UI font
RUN pacman -Sy --noconfirm --needed inter-font && pacman -Scc --noconfirm
# accessibility: the AT-SPI bus and its bindings (what Orca reads), Orca itself
RUN pacman -Sy --noconfirm --needed at-spi2-core python-atspi orca && pacman -Scc --noconfirm
# every language, precompiled — what the ShaniOS images ship (glibc-locales), so
# Settings > Date & language and first-boot setup offer what a real machine does.
# archlinux:base keeps no locale sources (NoExtract) and generates none but C.
RUN pacman -Sy --noconfirm --needed glibc-locales && pacman -Scc --noconfirm
# greetd itself: dev/admin-test.sh checks that systemd takes the automatic-login drop-in
RUN pacman -Sy --noconfirm --needed greetd && pacman -Scc --noconfirm
# the notification sound (freedesktop theme), as shani-desktop-niri ships it
RUN pacman -Sy --noconfirm --needed sound-theme-freedesktop && pacman -Scc --noconfirm
