[Unit]
Description=ShaniOS shell (Quickshell bar, launcher and Chronoa panel)
Documentation=https://github.com/shani8dev/shani-shell
# The panel talks to Chronoa only through the bridge's socket.
Wants=shani-chronoa-bridge.service
After=shani-chronoa-bridge.service
PartOf=graphical-session.target
After=graphical-session.target
Requisite=graphical-session.target

[Service]
# the icon theme apps use (Settings > Personalisation writes it), for the
# shell's own icons too; Quickshell has no icons without one
# (gsettings prints it quoted: 'Adwaita' — the first and last characters go);
# and the person's own folders (xdg-user-dirs: a German "Bilder", say) as the
# XDG_*_DIR variables screenshots, recordings and the camera save into;
# and no Qt window decoration: the shell's windows draw their own header in
# its colours (Common/AppWindow) - Qt's is a white Adwaita bar (QT_WAYLAND_DECORATION
# in niri's environment is for other Qt apps)
ExecStart=/bin/sh -c 'f="$${XDG_CONFIG_HOME:-$$HOME/.config}/user-dirs.dirs"; [ -r "$$f" ] && { set -a; . "$$f"; set +a; }; t=$(gsettings get org.gnome.desktop.interface icon-theme 2>/dev/null); t=$${t#?}; t=$${t%%?}; QS_ICON_THEME="$${t:-Adwaita}" QT_WAYLAND_DISABLE_WINDOWDECORATION=1 exec /usr/bin/qs -c shani'
Restart=on-failure
RestartSec=2

[Install]
WantedBy=graphical-session.target
