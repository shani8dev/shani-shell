[Unit]
Description=ShaniOS shell (Quickshell bar, launcher and Chronoa panel)
Documentation=https://github.com/shani8dev/shani-shell
# The panel talks to Chronoa only through the bridge's socket.
Wants=shani-chronoa-bridge.service
After=shani-chronoa-bridge.service
PartOf=graphical-session.target
After=graphical-session.target
Requisite=graphical-session.target

[Service]
# the icon theme apps use (Settings > Personalisation writes it), for the
# shell's own icons too; Quickshell has no icons without one
# (gsettings prints it quoted: 'Adwaita' — the first and last characters go)
ExecStart=/bin/sh -c 't=$(gsettings get org.gnome.desktop.interface icon-theme 2>/dev/null); t=$${t#?}; t=$${t%%?}; QS_ICON_THEME="$${t:-Adwaita}" exec /usr/bin/qs -c shani'
Restart=on-failure
RestartSec=2

[Install]
WantedBy=graphical-session.target
