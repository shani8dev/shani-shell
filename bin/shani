def _file_arg(arg: str) -> str:
    """A desktop entry's %u: a path, or a file:// URI, as an absolute path."""
    import os
    from urllib.parse import unquote, urlparse
    if arg.startswith("file://"):
        arg = unquote(urlparse(arg).path)
    return os.path.abspath(os.path.expanduser(arg))


def desktop_entry(name: str) -> str:
    desktop_id, title, comment, icon, categories, mimes, plain, with_file, _state = APPS[name]
    lines = ["[Desktop Entry]", "Type=Application", f"Name={title}", f"Comment={comment}", f"Icon={icon}",
             f"Exec=shani app {name}" + (" %u" if with_file else ""), "Terminal=false", f"Categories={categories}",
             # the shell draws it: there is no window for a startup notification to wait on
             "StartupNotify=false"]
    if mimes:
        lines.append("MimeType=" + ";".join(mimes) + ";")
    if plain is None:
        lines.append("NoDisplay=true")
    return "\n".join(lines) + "\n"


def _cmd_app(args) -> int:
    import os
    if args.write_desktop:
        os.makedirs(args.write_desktop, exist_ok=True)
        for name, spec in APPS.items():
            with open(os.path.join(args.write_desktop, spec[0] + ".desktop"), "w", encoding="utf-8") as out:
                out.write(desktop_entry(name))
        return 0
    if not args.name:
        for name, spec in APPS.items():
            print(f"{name:16} {spec[1]} - {spec[2]}")
        return 0
    spec = APPS.get(args.name)
    if spec is None:
        print(f"no such app: {args.name} (`shani app` lists them)", file=sys.stderr)
        return 2
    plain, with_file = spec[6], spec[7]
    if args.file and with_file:
        done = _run_call(with_file, [_file_arg(args.file)])
    elif plain is None:
        print(f"{spec[1]} opens a file: shani app {args.name} FILE", file=sys.stderr)
        return 2
    else:
        done = _run_call(plain[0], plain[1:])
    # already open somewhere: its window comes forward (a new one takes the focus by itself)
    if done == 0:
        try:
            _ipc("appRaise", spec[0])
        except RuntimeError:
            pass
    return done



def _cmd_state(_args) -> int:
    print(json.dumps(_state_json(), indent=2))
    return 0


def _cmd_doctor(_args) -> int:
    import shutil
    exe = shutil.which("shani-doctor")
    if exe is None:
        import os
        here = os.path.join(os.path.dirname(__file__), "shani-doctor.py")
        if os.path.isfile(here):
            exe = here
        else:
            print("shani-doctor is not on PATH here", file=sys.stderr)
            return 1
    return subprocess.run([exe]).returncode


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        prog=PROG,
        description="ShaniOS command center: drive the desktop and Chronoa "
                    "from the terminal, the way an agent would.",
    )
    sub = parser.add_subparsers(dest="command", metavar="GROUP_OR_COMMAND")
    sub.required = True

    # live state
    p = sub.add_parser("state", help="print live shell state as JSON")
    p.set_defaults(func=_cmd_state)
    # the doctor, forwarded
    p = sub.add_parser("doctor", help="check the tools the shell needs")
    p.set_defaults(func=_cmd_doctor)
    # the shell's own apps, the way a desktop entry starts them
    p = sub.add_parser("app", help="open one of the shell's apps, with a file if it takes one (no name: list them)")
    p.add_argument("name", nargs="?")
    p.add_argument("file", nargs="?")
    p.add_argument("--write-desktop", metavar="DIR", help="write the apps' desktop entries into DIR (the package does)")
    p.set_defaults(func=_cmd_app)
    # a raw call, for anything not in the groups
    p = sub.add_parser("call", help="call any shell IPC function directly")
    p.add_argument("fn")
    p.add_argument("fn_args", nargs="*")
    p.set_defaults(func=lambda a: _run_call(a.fn, a.fn_args))

    for group, commands in GROUPS.items():
        gp = sub.add_parser(group, help=f"{group} commands")
        gsub = gp.add_subparsers(dest="subcommand")
        for name, ipc_args, help_text in commands:
            cp = gsub.add_parser(name, help=help_text)
            cp.add_argument("args", nargs="*")
            cp.set_defaults(group=group, ipc_args=ipc_args)
            cp.set_defaults(func=lambda a, _n=name, _i=ipc_args: _run_group(a))
    return parser


def _run_group(args) -> int:
    needed = sum(1 for a in args.ipc_args if a.isupper() and "_" not in a or a.endswith("_NAME"))
    # simpler: count the placeholders in the template
    template = [a for a in args.ipc_args if a.isupper()]
    if len(args.args) < len(template):
        print(f"missing argument(s): {' '.join(template[len(args.args):])}",
              file=sys.stderr)
        return 2
    call = []
    # "-" for a TEXT: what is piped in (a terminal's pipe-command-output binding)
    extras = [sys.stdin.read()[-12000:] if a == "-" else a for a in args.args]
    # a PATH is the shell's to open, from wherever this was run: absolute
    extras = [os.path.abspath(os.path.expanduser(v)) if p == "PATH" and v and not v.startswith("+") and "://" not in v else v
              for p, v in zip([x for x in args.ipc_args if x.isupper()], extras)] + extras[len([x for x in args.ipc_args if x.isupper()]):]
    for part in args.ipc_args:
        if part.isupper():
            call.append(extras.pop(0))
        else:
            call.append(part)
    try:
        out = _ipc(args._fn_name, *call)
    except RuntimeError as exc:
        print(str(exc), file=sys.stderr)
        return 1
    if out:
        print(out)
    return 0


def _run_call(fn: str, fn_args: list) -> int:
    try:
        out = _ipc(fn, *fn_args)
    except RuntimeError as exc:
        print(str(exc), file=sys.stderr)
        return 1
    if out:
        print(out)
    return 0


def main() -> int:
    parser = build_parser()
    args = parser.parse_args()
    if args.command == "call":
        return _run_call(args.fn, args.fn_args)
    func = getattr(args, "func", None)
    if func is None:
        parser.print_help()
        return 2
    if hasattr(args, "group"):
        args._fn_name = _fn_name(args.group, args.subcommand)
    return func(args)


#: group command -> the IPC function it calls. Built from GROUPS so the
#: mapping cannot drift from the help above.
def _fn_name(group: str, subcommand: str) -> str:
    for name, ipc_args, _ in GROUPS[group]:
        if name == subcommand:
            # the IPC function is camelCase of the command; verify via GROUPS
            return IPC_NAMES.get((group, subcommand), subcommand)
    return subcommand


IPC_NAMES: dict[tuple[str, str], str] = {}


