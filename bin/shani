#!/usr/bin/env python3
"""shani — the command center for the desktop, agent-first.

The desktop should be drivable by an agent: every menu function behind one
CLI, with --json for machines and --help for people, on the IPC the shell
already exposes
(`qs -c shani ipc call shani <fn>`):

    shani ask "summarise my calendar today"
    shani media play-pause
    shani windows list --json
    shani volume up
    shani doctor
    shani state --json

Groups mirror the shell's surfaces; every command either drives the shell,
reads live state as JSON, or hands off to shani-doctor. Exit 0 on success,
1 when the shell is not running or said it could not.
"""

from __future__ import annotations

import argparse
import json
import os
import subprocess
import sys

PROG = "shani"

#: group -> [(command, [ipc args], help)].
#: Each entry is the exact IPC call, nothing more: what the CLI does is the
#: same thing the keybind does, through the same function.
