def _ipc(*args: str) -> str:
    """Call the shell's IPC. Returns stdout; raises on failure."""
    cmd = ["qs", "-c", "shani", "ipc", "call", "shani", *args]
    try:
        done = subprocess.run(cmd, capture_output=True, text=True, timeout=15)
    except (OSError, subprocess.TimeoutExpired) as exc:
        raise RuntimeError(f"could not reach the shell ({exc})") from exc
    if done.returncode != 0:
        why = (done.stderr or "").strip() or f"exit {done.returncode}"
        raise RuntimeError(f"qs said: {why}")
    return done.stdout.strip()


def _state_json() -> dict:
    return json.loads(_ipc("state"))


def _cmd_state(_args) -> int:
    print(json.dumps(_state_json(), indent=2))
    return 0


def _cmd_doctor(_args) -> int:
    import shutil
    exe = shutil.which("shani-doctor")
    if exe is None:
        import os
        here = os.path.join(os.path.dirname(__file__), "shani-doctor.py")
        if os.path.isfile(here):
            exe = here
        else:
            print("shani-doctor is not on PATH here", file=sys.stderr)
            return 1
    return subprocess.run([exe]).returncode


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        prog=PROG,
        description="ShaniOS command center: drive the desktop and Chronoa "
                    "from the terminal, the way an agent would.",
    )
    sub = parser.add_subparsers(dest="command", metavar="GROUP_OR_COMMAND")
    sub.required = True

    # live state
    p = sub.add_parser("state", help="print live shell state as JSON")
    p.set_defaults(func=_cmd_state)
    # the doctor, forwarded
    p = sub.add_parser("doctor", help="check the tools the shell needs")
    p.set_defaults(func=_cmd_doctor)
    # a raw call, for anything not in the groups
    p = sub.add_parser("call", help="call any shell IPC function directly")
    p.add_argument("fn")
    p.add_argument("fn_args", nargs="*")
    p.set_defaults(func=lambda a: _run_call(a.fn, a.fn_args))

    for group, commands in GROUPS.items():
        gp = sub.add_parser(group, help=f"{group} commands")
        gsub = gp.add_subparsers(dest="subcommand")
        for name, ipc_args, help_text in commands:
            cp = gsub.add_parser(name, help=help_text)
            cp.add_argument("args", nargs="*")
            cp.set_defaults(group=group, ipc_args=ipc_args)
            cp.set_defaults(func=lambda a, _n=name, _i=ipc_args: _run_group(a))
    return parser


def _run_group(args) -> int:
    needed = sum(1 for a in args.ipc_args if a.isupper() and "_" not in a or a.endswith("_NAME"))
    # simpler: count the placeholders in the template
    template = [a for a in args.ipc_args if a.isupper()]
    if len(args.args) < len(template):
        print(f"missing argument(s): {' '.join(template[len(args.args):])}",
              file=sys.stderr)
        return 2
    call = []
    extras = list(args.args)
    for part in args.ipc_args:
        if part.isupper():
            call.append(extras.pop(0))
        else:
            call.append(part)
    try:
        out = _ipc(args._fn_name, *call)
    except RuntimeError as exc:
        print(str(exc), file=sys.stderr)
        return 1
    if out:
        print(out)
    return 0


def _run_call(fn: str, fn_args: list) -> int:
    try:
        out = _ipc(fn, *fn_args)
    except RuntimeError as exc:
        print(str(exc), file=sys.stderr)
        return 1
    if out:
        print(out)
    return 0


def main() -> int:
    parser = build_parser()
    args = parser.parse_args()
    if args.command == "call":
        return _run_call(args.fn, args.fn_args)
    func = getattr(args, "func", None)
    if func is None:
        parser.print_help()
        return 2
    if hasattr(args, "group"):
        args._fn_name = _fn_name(args.group, args.subcommand)
    return func(args)


#: group command -> the IPC function it calls. Built from GROUPS so the
#: mapping cannot drift from the help above.
def _fn_name(group: str, subcommand: str) -> str:
    for name, ipc_args, _ in GROUPS[group]:
        if name == subcommand:
            # the IPC function is camelCase of the command; verify via GROUPS
            return IPC_NAMES.get((group, subcommand), subcommand)
    return subcommand


IPC_NAMES: dict[tuple[str, str], str] = {}


