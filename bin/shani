def _ipc(*args: str) -> str:
    """Call the shell's IPC. Returns stdout; raises on failure."""
    # SHANI_QS_CONFIG: a checkout's shani/ (the tests' shell is `qs -p <dir>`)
    import os
    where = ["-p", os.environ["SHANI_QS_CONFIG"]] if os.environ.get("SHANI_QS_CONFIG") else ["-c", "shani"]
    cmd = ["qs", *where, "ipc", "call", "shani", *args]
    try:
        done = subprocess.run(cmd, capture_output=True, text=True, timeout=15)
    except (OSError, subprocess.TimeoutExpired) as exc:
        raise RuntimeError(f"could not reach the shell ({exc})") from exc
    if done.returncode != 0:
        why = (done.stderr or "").strip() or f"exit {done.returncode}"
        raise RuntimeError(f"qs said: {why}")
    return done.stdout.strip()


def _state_json() -> dict:
    return json.loads(_ipc("state"))


#: The shell's own apps: its surfaces, as things a person starts. One table
#: feeds three things, so they cannot drift apart: `shani app NAME [FILE]`,
#: the desktop entries (`shani app --write-desktop DIR`, run by the package:
#: the launcher's app list, the dock's pins, "Open with" and the default
#: apps all read those), and dev/shell-parts/apps.sh, which opens each one in
#: the live shell.
#:   name: (desktop id, Name, Comment, Icon, Categories, [mime types],
#:          IPC without a file, IPC with a file or None, state key that is truthy once open)
#: An entry with no way to open without a file is NoDisplay: it is offered
#: for its files, and is not in the app grid.
